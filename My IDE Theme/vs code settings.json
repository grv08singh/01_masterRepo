{
    //"editor.fontFamily": "Consolas",
    "editor.fontFamily": "Consolas, 'Courier New', monospace",
    "editor.fontSize": 14,
    "editor.fontLigatures": true,
    "editor.fontWeight": 350,
    "terminal.integrated.fontSize": 14,
    "terminal.integrated.fontWeight": 350,
    
    "workbench.colorCustomizations": {
        "titleBar.activeBackground":"#004cbf",
        "titleBar.activeForeground":"#dbdbdb",

        "activityBar.background": "#008e8e",
        "activityBar.foreground":"#ffff03",
        "activityBar.inactiveForeground": "#FFFFFF",

        "sideBar.border": "#008e8e",
        "sideBarTitle.background":"#37b0b0",
        "sideBarTitle.foreground":"#000000",

        "sideBarSectionHeader.background":"#74cccc",
        "sideBarSectionHeader.foreground": "#000000",
        
        "sideBar.background": "#b0e0e0",
        "sideBar.foreground": "#000000",

        //"editorGroupHeader.tabsBackground":"#e4f4f4",
        "tab.border":"#000000",

        "tab.activeBackground": "#e4f4f4",
        "tab.activeForeground": "#000000",
        //"tab.activeBorder":"#007777",

        "tab.inactiveBackground": "#ffffff",
        "tab.inactiveForeground": "#007777",

        "breadcrumb.background":"#dbdbdb",
        "breadcrumb.foreground":"#008e8e",

        "editor.background": "#e4f4f4",
        "editor.foreground":"#000000",
        
        "editor.lineHighlightBackground": "#ceeaea",
        "editor.selectionBackground": "#a8dede",

        "notebook.cellEditorBackground": "#ecf8f8",
        "notebook.editorBackground": "#f8f8f8",
        "notebook.cellBorderColor": "#b0e0e0",
        "notebook.focusedCellBackground": "#d0f0f0",
        "notebook.focusedCellBorder": "#008e8e",
        "notebook.outputContainerBackgroundColor": "#ededed",

        "panel.border": "#008e8e",
        "panelTitle.border": "#008e8e",
        "panelTitle.activeForeground":"#008e8e",
        "panelTitle.activeBorder":"#008e8e",
        "panelTitle.inactiveForeground":"#747474",
        "panelTitleBadge.background": "#d040d0",
        "panelTitleBadge.foreground": "#ffffff",
        "panel.background":"#e4f4f4",

        "outputView.background": "#e4f4f4",

        "terminal.background":"#e4f4f4",
        "terminal.foreground":"#000000",
        "window.inactiveBorder":"#000000",
    },
    "workbench.colorTheme": "Light+",
    "amazonQ.suppressPrompts": {
        "amazonQChatDisclaimer": true,
        "amazonQChatPairProgramming": true
    },

    "editor.semanticTokenColorCustomizations": {
        "rules": {
            "module": {
                "foreground": "#001eff",
                //"fontStyle": "bold"
            },
            "class":{
                "foreground": "#000000",
                //"fontStyle": "bold"
            },
            "method": {
                "foreground": "#020202",
                //"fontStyle": "bold"
            },
            "function": {
                "foreground": "#000000",
                //"fontStyle": "bold"
            }
        }
    },

    "editor.tokenColorCustomizations": {
        "[Light+]": {
            "textMateRules": [
                {
                    "scope": [
                        //"meta.member.access.python",
                        //"meta.attribute.python",
                        //"keyword.control.import.python",
                        "source.python",
                        "variable.other.python",
                        "punctuation.separator.element.python"
                    ],
                    "settings": {
                        //"fontStyle": "bold",
                        "foreground": "#001eff"
                    }
                }
            ]
        }
    },
    "explorer.confirmDelete": false,
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "editor.minimap.enabled": false,
    "claudeCode.preferredLocation": "panel",
    "python.terminal.useEnvFile": true,
    "explorer.confirmDragAndDrop": false,
    "jupyter.askForKernelRestart": false,
    "[python]": {
        "diffEditor.ignoreTrimWhitespace": false,
        "editor.defaultColorDecorators": "never",
        "editor.formatOnType": true,
        //"editor.wordBasedSuggestions": "off"
    },
    "git.enableSmartCommit": true,
    "git.confirmSync": false,
    "git.openRepositoryInParentFolders": "never",
    "gitlens.ai.model": "vscode",
    "gitlens.ai.vscode.model": "copilot:gpt-4.1",
    "mcpServers": {},
    "codium.git.showCommitNotification": false,
    "workbench.startupEditor": "none",
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false,
        "python": false
    },
    "amazonQ.telemetry": false,
    "python.analysis.typeCheckingMode": "standard",
    "terminal.integrated.automationProfile.linux": {},
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "source": "PowerShell",
            "icon": "terminal-powershell"
        },
        "Command Prompt": {
            "path": [
                "${env:windir}\\Sysnative\\cmd.exe",
                "${env:windir}\\System32\\cmd.exe"
            ],
            "args": [],
            "icon": "terminal-cmd"
        },
        "Git Bash": {
            "source": "Git Bash",
            "icon": "terminal-git-bash"
        },
        "Ubuntu (WSL)": {
            "path": "C:\\Windows\\System32\\wsl.exe",
            "args": [
                "-d",
                "Ubuntu"
            ]
        }
    },
    "terminal.integrated.defaultProfile.windows": "Ubuntu (WSL)",
    "chat.viewSessions.orientation": "stacked",
    "chat.tips.enabled": false,
    "github.copilot.nextEditSuggestions.eagerness": "low",
    "github.copilot.nextEditSuggestions.enabled": false,
    "editor.wordWrap": "on",
    "terminal.integrated.commandsToSkipShell": [
        "kilo-code.new.agentManagerOpen",
        "kilo-code.new.agentManager.showTerminal"
    ],
    "kilo-code.new.agentWorkStyle": "autonomous",
    "kilo-code.new.showTaskTimeline": false,
    "remote.autoForwardPortsSource": "hybrid",
    "editor.inlineSuggest.showToolbar": "always"
}